{
  "name": "19h47/19h47",
  "description": "19h47's WordPress theme",
  "type": "wordpress-theme",
  "authors": [
    {
      "name": "Jérémy Levron",
      "email": "jeremylevron@19h47.fr"
    }
  ],
  "require": {
    "timber/timber": "^2.3",
    "twig/html-extra": "^3.8",
    "twig/intl-extra": "^3.8"
  },
  "autoload": {
    "psr-4": {
      "DixNeufHeureQuaranteSept\\": "./includes"
    },
    "files": [
      "./includes/helpers.php"
    ]
  },
	"config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.3.30"
    },
    "sort-packages": true
  },
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.0"
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf"
  }
}
