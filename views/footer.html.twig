						<black-board-button action="save">
							<a class="BlackBoard__control Link-layer inline-block align-baseline" href="#" download="19h47.png">
								{{- __( 'Save me', '19h47'  ) -}}
								<span data-text="{{- __( 'Save me', '19h47'  ) -}}"></span>
							</a>
						</black-board-button>
						<br>
						<black-board-button action="clear">
							<button class="BlackBoard__control Link-layer js-navigation inline-block align-baseline" type="button">
								{{- __( 'Clear me', '19h47' ) -}}
								<span data-text="{{- __( 'Clear me', '19h47' ) -}}"></span>
							</button>
						</black-board-button>

					</p>
				</div>
			</div>

			<div class="grid grid-cols-12 gap-x-16">
				<div class="col-span-12 md:col-span-5 md:col-start-2">
					<p class="text-13 font-medium uppercase tracking-100">
						{{- __( 'Front-end developer', '19h47' ) -}}
					</p>
				</div>

				<div class="col-span-12 md:col-span-5 md:text-right">
					<p class="text-13 font-medium uppercase tracking-100">
						{{- __( 'Born', '19h47' ) }} {{ age }} {{ __( 'years ago', '19h47' ) -}}
