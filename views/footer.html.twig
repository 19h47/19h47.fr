							{{- __( 'Instagram', '19h47'  ) -}}
							<span data-text="{{- __( 'Instagram', '19h47'  ) -}}"></span>
						</a>
						<br>
						<a class="Link-layer inline-block align-baseline" href="https://github.com/19h47" target="_blank" rel="noopener noreferer">
							{{- __( 'Github', '19h47' ) -}}
							<span data-text="{{- __( 'Github', '19h47' ) -}}"></span>
						</a>
					</p>
				</div>

				{# Paint control #}
				<div class="col-span-12 hidden lg:col-span-2 lg:block">
