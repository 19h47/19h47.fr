<!DOCTYPE html>
<html {{ site.language_attributes }} {{ html_class( 'no-js no-touch' ) }}>
	<head>
		<meta charset="{{ site.charset }}">
		<link rel="profile" href="http://gmpg.org/xfn/11">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
		<meta name="p:domain_verify" content="8aacaa5d228029b4162e31d098b6ecd7"/>

		{{ function( 'wp_head' ) }}

		{{ include( 'components/google-analytics.html.twig' ) }}

	</head>
	<body class="page--is-loading"{% if barba_namespace %} data-context="{{ barba_namespace }}"{% endif %}>
		<header class="l-header pt-64 pb-32">
			<div class="relative mx-auto max-w-full px-32">

				<div class="grid grid-cols-12 items-baseline gap-x-16">

					{# Live: col-sm-6 col-md-4 offset-md-1 → cols 2–5 #}
					<div class="col-span-12 sm:col-span-6 md:col-span-4 md:col-start-2">
						<h1 class="relative z-1 m-0 text-24 font-medium leading-32">
							<a href="{{ site.url }}">
								Jérémy Levron<sup class="align-text-top text-13 font-medium uppercase tracking-100 opacity-40">{{- site.name -}}</sup>
							</a>
						</h1>
					</div>

					{# Live: col-2 col-lg-1 offset-lg-3 → md cols 6–7, lg col 9 #}
					<div class="col-span-2 hidden text-right md:col-start-6 md:block lg:col-span-1 lg:col-start-9 lg:text-center">
						<a class="Link-layer js-navigation m-0 inline-block text-13 font-medium uppercase leading-32 tracking-100" href="{{ page_permalink.who_i_am }}" data-namespace="who-i-am">
							{{- __( 'Who I am' ) -}}
							<span data-text="Who I am"></span>
						</a>
					</div>

					{# Live: col-2 col-lg-1 → md cols 8–9, lg col 10 #}
					<div class="col-span-2 hidden text-right md:block lg:col-span-1 lg:text-center">
						<a class="Link-layer js-navigation m-0 inline-block align-baseline text-13 font-medium uppercase leading-32 tracking-100" href="{{ page_permalink.work }}" data-namespace="work">
							{{- __( 'Work' ) -}}
							<span data-text="Work"></span>
						</a>
					</div>

					{# Live: col-2 col-lg-1 → md cols 10–11, lg col 11 #}
					<div class="col-span-2 hidden text-right md:block lg:col-span-1 lg:text-center">
						<a class="Link-layer js-navigation m-0 inline-block align-baseline text-13 font-medium uppercase leading-32 tracking-100" href="{{ page_permalink.thoughts }}" data-namespace="what-i-think">
							{{- __( 'Thoughts' ) -}}
							<span data-text="Thoughts"></span>
						</a>
					</div>

				</div>

			</div>
		</header>
		{{- include( 'components/transition.html.twig' ) -}}
		<main data-barba="wrapper" class="js-wrapper h-full">
			<div {{ body_class( 'pt-128 md:pb-224' ) }} data-barba="container"{% if barba_namespace %} data-barba-namespace="{{ barba_namespace }}"{% endif %}>
