{{ include( 'header.html.twig' ) }}

{% block post %}

	<div class="relative mx-auto max-w-full px-32">

		{% block start_wrapper %}

			<div class="my-64">

		{% endblock %}

		{% block header %}

			<header class="grid grid-cols-12 gap-x-16">
				<div class="js-title col-span-12 md:col-span-10 md:col-start-2">
					<p class="m-0 text-13 font-medium uppercase tracking-100 opacity-40">
						{{ post.title }}
						<span data-text="{{ post.title }}"></span>
					</p>
				</div>
			</header>

		{% endblock %}


		{% block content %}

			<section class="grid grid-cols-12 gap-x-16">
				<div class="js-content col-span-12 md:col-span-10 md:col-start-2">
					<div class="font-extralight">
						{{ post.content }}
					</div>
				</div>
			</section>

		{% endblock %}

		{% block footer %}{% endblock %}


		{% block end_wrapper %}

			</div>

		{% endblock %}

	</div>

{% endblock %}


{# Footer #}
{{ include( 'footer.html.twig' ) }}
