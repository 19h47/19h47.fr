{#
/**
 * Tumblr photo posts partial (SSR and REST).
 *
 * @package WordPress
 * @subpackage 19h47
 */
#}
{% for post in posts %}
	<div class="col-span-12 md:col-span-6">
		<a
			class="block"
			href="{{ post.src }}"
			target="_blank"
			rel="noopener noreferrer"
		>
			<img
				class="aspect-square w-full object-contain"
				src="{{ post.image.src }}"
				srcset="{{ post.image.srcset }}"
				sizes="(min-width: 992px) 42vw, 100vw"
				alt="{{ post.label }}"
				loading="lazy"
				decoding="async"
			>
		</a>
	</div>
{% endfor %}
