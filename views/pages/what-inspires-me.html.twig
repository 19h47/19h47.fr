{% extends 'index.html.twig' %}

{# Tumblr #}
{% block start_wrapper %}
	<tumblr-feed class="block my-64" per-page="20">
{% endblock %}

{% block header %}
	<header class="grid grid-cols-12 gap-x-16">
		<div class="col-span-12 md:col-span-10 md:col-start-2">
			<p class="js-loader is-loading Loader m-0 text-13 font-medium uppercase leading-32 tracking-100">
				{{ post.title }}
				<span data-text="{{ post.title }}"></span>
			</p>
		</div>
	</header>
{% endblock %}

{% block content %}

	<section class="my-32 grid grid-cols-12 gap-x-16">
		<div class="col-span-12 md:col-span-10 md:col-start-2">
			<section class="response grid grid-cols-12 gap-x-16"></section>
		</div>
	</section>

{% endblock %}

{% block footer %}

	<footer class="grid grid-cols-12 gap-x-16">
		<div class="col-span-12 md:col-span-10 md:col-start-2">
			<button class="load-more relative m-0 inline-block align-baseline text-13 font-medium uppercase tracking-100 text-white" type="button">
				<div class="Link-layer">
					Load more
					<span data-text="Load more"></span>
				</div>
				<span class="pointer-events-none absolute bottom-0 left-full pb-8 pl-4 text-[smaller] text-white/40" data-count aria-hidden="true"></span>
			</button>
		</div>
	</footer>

{% endblock %}

{% block end_wrapper %}
	</tumblr-feed>
{% endblock %}
