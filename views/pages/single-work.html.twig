{% extends 'index.html.twig' %}

{% block header %}
	<header class="grid grid-cols-12 gap-x-16">
		<div class="col-span-12 md:col-span-10 md:col-start-2">
			<a class="Link-layer m-0 inline-block text-13 font-medium uppercase leading-32 tracking-100" href="{{ page_permalink.work }}">
				{{- __( 'Work', '19h47' ) -}}
				<span data-text="{{- __( 'Work', '19h47' ) -}}"></span>
			</a>
		</div>
	</header>
{% endblock %}

{% block content %}

	<section class="grid grid-cols-12 gap-x-16">

		<div class="col-span-12 md:col-span-10 md:col-start-2">

			<h2 class="Work__title mt-16 font-bold text-white">
				{{- post.title -}}
				<sup class="hidden align-text-top text-13 font-medium uppercase tracking-100 opacity-40 sm:inline">
					{{- post.meta( 'year' )  -}}
				</sup>
			</h2>

		</div>


		<div class="col-span-12 md:col-span-6 md:col-start-2">

			<div class="text-white">

				{{- post.content -}}

				{% if post.meta( 'link' ) %}
					<a class="Link-layer inline-block align-baseline text-18 font-normal" href="{{ post.meta( 'link' ) }}" target="_blank" rel="noopener noreferer">
						{{- __( 'View the website', '19h47' ) -}}
						<span data-text="{{- __( 'View the website', '19h47' ) -}}"></span>
					</a>
				{% endif %}

				{% if post.meta( 'repository' ) %}

					{% if work.details.link %}<br>{% endif %}

					<a class="Link-layer inline-block align-baseline text-18 font-normal" href="{{ post.meta( 'repository' ) }}" target="_blank" rel="noopener noreferer">
						{{- __( 'View the repository', '19h47' ) -}}
						<span data-text="{{- __( 'View the repository', '19h47' ) -}}"></span>
					</a>
				{% endif %}

			</div>

		</div>

		{% if  post.meta( 'client' ) or post.meta( 'role' ) %}
			<aside class="col-span-12 md:col-span-3 md:col-start-9">

				{% if post.meta( 'client' ) %}
					<p class="text-white">
						<span class="text-13 uppercase tracking-100 opacity-40">
							{{ __( 'Client', '19h47' ) }}
						</span>
						<br>
						<span class="text-18 font-medium">
							{{- post.meta( 'client' ) | map( client => client.name ) | join( '<br />' ) -}}
						</span>
					</p>
				{% endif %}

				{% if post.meta( 'role' ) %}
					<p class="text-white">
						<span class="text-13 uppercase tracking-100 opacity-40">
							{{- __( 'Role', '19h47' ) -}}
						</span><br>
						<span class="text-18 font-medium">
							{{- post.meta( 'role' ) | map( role => role.name ) | join( '<br/ >' ) -}}
						</span>
					</p>
				{% endif %}

			</aside>
		{% endif %}

		{% for section in post.meta( 'sections' ) %}
			{{- include( 'sections/section-' ~ section.acf_fc_layout ~ '.html.twig' ) -}}
		{% endfor %}

	</section>

{% endblock %}

{% block footer %}

	{# Navigation #}
	<nav class="mt-64 grid grid-cols-12 gap-x-16">

		<div class="col-span-12 md:col-span-5 md:col-start-2">
			<a class="js-work-navigation Work__navigation inline-block" href="{{ post.next.link }}" rel="next" data-namespace="work" data-color="{{ post.next.color }}">
				<span class="text-13 font-medium uppercase tracking-100 text-white">
					{{- __( 'Next work', '19h47' ) -}}
				</span>
				<br>
				<p class="Link-layer mt-0 inline-block align-baseline">
					{{- post.next.title -}}
					<span data-text="{{ post.next.title }}"></span>
				</p>
			</a>
		</div>

		<div class="col-span-12 md:col-span-5 md:text-right">
			<a class="js-work-navigation Work__navigation inline-block" href="{{ post.previous.link }}" rel="prev" data-namespace="work" data-color="{{ post.previous.color }}">
				<span class="text-13 font-medium uppercase tracking-100 text-white">
					{{- __( 'Previous work', '19h47' ) -}}
				</span>
				<br>
				<p class="Link-layer mt-0 inline-block align-baseline">
					{{ post.previous.title }}
					<span data-text="{{ post.previous.title }}"></span>
				</p>
			</a>
		</div>

	</nav>

{% endblock %}
