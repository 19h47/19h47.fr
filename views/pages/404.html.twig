{% extends 'index.html.twig' %}

{% block start_wrapper %}
	<div class="mt-64">
{% endblock %}

{% block header %}
	<header class="grid grid-cols-12 gap-x-16">
		<div class="col-span-12 md:col-span-10 md:col-start-2">
			<p class="m-0 text-13 font-medium uppercase leading-32 tracking-100 opacity-40">
				404
				<span data-text="404"></span>
			</p>
		</div>
	</header>
{% endblock %}

{% block content %}

	<television-noise>
		<canvas class="fixed inset-0 h-full w-full opacity-60"></canvas>
	</television-noise>

	<section class="grid grid-cols-12 gap-x-16">
		<div class="col-span-12 md:col-span-10 md:col-start-2">
			<div class="my-64 font-extralight text-white">
				<p>
					{{- __( 'Sorry, we couldn\'t find what you\'re looking for. 😔', '19h47' ) -}}
				</p>
			</div>

		</div>
	</section>

{% endblock %}

{% block end_wrapper %}
	</div>
{% endblock %}
