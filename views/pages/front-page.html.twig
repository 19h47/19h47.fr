{% extends 'index.html.twig' %}

{% block start_wrapper %}
	<div class="my-64 hidden md:block">
{% endblock %}

{% block header %}
	<header class="grid grid-cols-12 gap-x-16">
		<div class="col-span-12 md:col-span-10 md:col-start-2">
			<p class="BlackBoard__instruction is-loading Loader m-0 text-13 font-medium uppercase leading-32 tracking-100">
				Click. Drag. Draw!
				<span data-text="Click. Drag. Draw!"></span>
			</p>
		</div>
	</header>
{% endblock %}

{% block content %}

	<black-board empty>
		<canvas class="fixed inset-0 z-[1] h-full w-full"></canvas>
	</black-board>

{% endblock %}

{% block end_wrapper %}
	</div>
{% endblock %}
