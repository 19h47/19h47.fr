{% extends 'index.html.twig' %}

{% block start_wrapper %}
	<div class="my-64">
{% endblock %}

{% block header %}{% endblock %}

{% block content %}

	{% for post in posts %}

		<article class="my-64 grid grid-cols-12 gap-x-16" id="post-{{ post.ID }}">
			<div class="col-span-12 md:col-span-10 md:col-start-2">

				<p class="text-13 font-medium uppercase leading-32 tracking-100 opacity-40">
					{{- post.date( 'F j, Y' ) -}}
				</p>

				<h2 class="mt-0">
					{{- post.title -}}
				</h2>

			</div>

			{% if post.thumbnail %}
				<div class="col-span-12 md:col-span-10 md:col-start-2">
					<p>
						{{ include( 'components/image.html.twig', {
							image: post.thumbnail,
							classes: [ 'img-full', 'box-shadow' ],
							size: 'full',
							sizes: '100vw',
						}, with_context = false ) }}

						{% if post.thumbnail.caption %}
							<span class="block text-right text-13 font-normal">
								{{ post.thumbnail.caption }}
							</span>
						{% endif %}
					</p>
				</div>
			{% endif %}

			<div class="col-span-12 md:col-span-8 md:col-start-3 wysiwyg">{{- post.content -}}</div>
		</article>

	{% endfor %}

{% endblock %}

{% block end_wrapper %}
	</div>
{% endblock %}
